# Server (Phase 5A / 5B / 5C) — placeholders only. Copy to `.env` locally and fill values.
# NEVER commit real credentials. NEVER expose these to Vite/React (VITE_*).

PORT=3001

# Amazon SP-API — Login with Amazon (LWA) + Selling Partner API
# Server-side only. Obtain via Seller Central app registration + seller authorization.
# Used for status probe + GET_SALES_AND_TRAFFIC_REPORT ingestion (performance only).
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=
AMAZON_SELLER_ID=

# SP-API region endpoint: na | eu | fe  (India typically uses eu)
AMAZON_SP_API_REGION=eu

# Optional override (defaults to https://api.amazon.com/auth/o2/token)
# AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# Flipkart Seller APIs (server-side only — not integrated yet)
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=

# Meesho APIs (server-side only — not integrated yet)
MEESHO_API_KEY=
